<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>국어 러너 게임: 동형이의어 vs 다의어</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #f0f2f5;
            font-family: 'Malgun Gothic', sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            overflow: hidden;
        }

        #lobby, #result-screen {
            text-align: center;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }

        button {
            padding: 10px 20px;
            font-size: 16px;
            margin: 10px;
            cursor: pointer;
            border: none;
            border-radius: 5px;
            background-color: #4CAF50;
            color: white;
            font-weight: bold;
            transition: 0.2s;
        }

        button:hover { background-color: #45a049; }
        .btn-easy { background-color: #4cabf5; }
        .btn-medium { background-color: #ff9800; }
        .btn-hard { background-color: #f44336; }

        #game-container {
            display: none;
            position: relative;
            width: 800px;
            height: 400px;
            background: linear-gradient(to bottom, #87CEEB, #E0F6FF);
            border: 4px solid #333;
            border-radius: 10px;
            overflow: hidden;
        }

        /* UI 영역 */
        #ui-panel {
            position: absolute;
            top: 10px;
            width: 96%;
            left: 2%;
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: bold;
            color: #333;
            z-index: 10;
        }

        /* 바닥 */
        #ground {
            position: absolute;
            bottom: 0;
            width: 100%;
            height: 50px;
            background-color: #8B4513;
            border-top: 5px solid #228B22;
        }

        /* 플레이어 캐릭터 */
        #player {
            position: absolute;
            bottom: 50px;
            left: 100px;
            width: 50px;
            height: 60px;
            background-color: #FFD700;
            border: 2px solid #333;
            border-radius: 5px;
            transition: height 0.1s, bottom 0.05s;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
        }

        /* 장애물 (단어) */
        #obstacle {
            position: absolute;
            bottom: 50px;
            right: -150px;
            padding: 10px 20px;
            background-color: #ff5722;
            color: white;
            font-size: 20px;
            font-weight: bold;
            border-radius: 8px;
            border: 2px solid #333;
            white-space: nowrap;
        }

        /* 해설 및 안내 팝업 */
        #explanation-box {
            display: none;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 500px;
            background: white;
            border: 3px solid #333;
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            z-index: 20;
            box-shadow: 0 0 20px rgba(0,0,0,0.3);
        }

        #explanation-box h2 { margin-top: 0; }
        #explanation-text { text-align: left; margin: 15px 0; line-height: 1.6; }

        /* 가이드 텍스트 */
        #guide {
            margin-top: 15px;
            font-size: 14px;
            color: #666;
        }
    </style>
</head>
<body>

    <div id="lobby">
        <h1>🏃‍♂️ 국어 러너 게임 🏃‍♀️</h1>
        <p>다가오는 단어를 보고 알맞은 조작을 선택하세요!</p>
        <p style="font-weight: bold; color: #d32f2f;">⬆ 방향키 (점프) = 동형이의어 | ⬇ 방향키 (슬라이드) = 다의어</p>
        <h3>난이도를 선택하세요</h3>
        <button class="btn-easy" onclick="startGame('easy')">하 (시간 넉넉, 느림)</button>
        <button class="btn-medium" onclick="startGame('medium')">중 (보통)</button>
        <button class="btn-hard" onclick="startGame('hard')">상 (시간 촉박, 빠름)</button>
    </div>

    <div id="game-container">
        <div id="ui-panel">
            <div id="info-progress">진행도: <span id="current-question">1</span> / <span id="total-questions">10</span></div>
            <div id="info-timer">남은 시간: <span id="timer">60</span>초</div>
            <div id="info-score">맞힌 개수: <span id="score">0</span></div>
        </div>
        
        <div id="player">🏃</div>
        <div id="obstacle">단어</div>
        <div id="ground"></div>

        <div id="explanation-box">
            <h2 id="exp-title" style="color:red;">틀렸습니다!</h2>
            <div id="explanation-text">해설 내용</div>
            <button onclick="nextQuestion()">계속하기</button>
        </div>
    </div>

    <div id="result-screen" style="display:none;">
        <h1 id="result-title">게임 종료!</h1>
        <p id="result-stats">정답률: 0% | 남은 시간: 0초</p>
        <button onclick="returnToLobby()">다시 하기</button>
    </div>

    <div id="guide">※ 게임 창을 클릭한 후 방향키(⬆, ⬇)로 조작해 주세요.</div>

    <script>
        // 문제 데이터베이스 (동형이의어 / 다의어 구분)
        const wordDatabase = [
            { word: "배 (Ship / Pear)", type: "homonym", meaning: "물 위에 떠서 다니는 배 / 먹는 과일 배", exp: "<b>동형이의어:</b> 소리는 같으나 뜻이 서로 전혀 다른 단어입니다. '타는 배'와 '먹는 배'는 어원이 완전히 다릅니다." },
            { word: "다리 (Bridge / Leg)", type: "polysemy", meaning: "사람의 다리 / 한강 다리", exp: "<b>다의어:</b> 하나의 단어가 두 가지 이상의 관련된 뜻을 가진 단어입니다. '한강 다리'는 사람의 '다리'가 몸을 지탱하는 모습과 유사하여 확장된 의미입니다." },
            { word: "밤 (Night / Chestnut)", type: "homonym", meaning: "어두운 밤 / 맛있는 밤 나무 열매", exp: "<b>동형이의어:</b> '시간의 밤(夜)'과 '식물의 밤(栗)'은 우연히 소리만 같을 뿐 의미상 아무런 연관이 없습니다." },
            { word: "손 (Hand / Worker)", type: "polysemy", meaning: "신체의 손 / 부족한 일손", exp: "<b>다의어:</b> 신체 부위 '손'에서 확장되어 '노동력(일손)'이나 '영향력'이라는 연관된 의미를 가집니다." },
            { word: "눈 (Eye / Snow)", type: "homonym", meaning: "보는 눈 / 하늘에서 내리는 눈", exp: "<b>동형이의어:</b> '신체의 눈(目)'과 '자연 현상의 눈(雪)'은 글자와 소리만 같은 완전히 별개의 단어입니다." },
            { word: "머리 (Head / Brain)", type: "polysemy", meaning: "신체의 머리 / 머리가 좋다(지능)", exp: "<b>다의어:</b> 신체 부위인 '머리'의 본래 뜻에서 생각을 하는 주체인 '지능/정신'으로 의미가 확장된 관계입니다." },
            { word: "말 (Word / Horse)", type: "homonym", meaning: "사람의 말 / 달리는 동물 말", exp: "<b>동형이의어:</b> '언어(言)'와 '동물(馬)'은 소리만 같고 중심 의미가 아예 다릅니다." },
            { word: "발 (Foot / Step)", type: "polysemy", meaning: "신체의 발 / 발이 넓다(인맥)", exp: "<b>다의어:</b> 걸어 다니는 신체 '발'의 의미에서 비롯되어 활동 범위를 뜻하는 '인맥이 넓다'로 확장되었습니다." },
            { word: "구도 (Composition / Tool)", type: "homonym", meaning: "그림의 구도 / 불교의 구도(길을 구함)", exp: "<b>동형이의어:</b> 미술의 '구도(構圖)'와 종교적 진리를 구하는 '구도(求道)'는 한자도 다르고 뜻도 완전히 다릅니다." },
            { word: "줄 (String / Queue)", type: "polysemy", meaning: "악기의 줄 / 차례를 기다리는 줄", exp: "<b>다의어:</b> 가늘고 긴 형태를 가진 '실이나 선'이라는 기본 의미에서 사람들이 서 있는 '선(열)'으로 모양의 유사성을 통해 확장되었습니다." }
        ];

        // 게임 상태 변수
        let gameWords = [];
        let currentIndex = 0;
        let score = 0;
        let timerInterval;
        let timeLeft = 0;
        let isPaused = false;
        let gameActive = false;
        let speed = 5;
        let maxTime = 60;

        // 플레이어 동작 상태
        let isJumping = false;
        let isSliding = false;

        // DOM 요소
        const lobby = document.getElementById('lobby');
        const gameContainer = document.getElementById('game-container');
        const resultScreen = document.getElementById('result-screen');
        const obstacle = document.getElementById('obstacle');
        const player = document.getElementById('player');
        
        const txtCurrent = document.getElementById('current-question');
        const txtTotal = document.getElementById('total-questions');
        const txtTimer = document.getElementById('timer');
        const txtScore = document.getElementById('score');
        
        const expBox = document.getElementById('explanation-box');
        const expTitle = document.getElementById('exp-title');
        const expText = document.getElementById('explanation-text');

        // 게임 시작
        function startGame(difficulty) {
            lobby.style.display = 'none';
            resultScreen.style.display = 'none';
            gameContainer.style.display = 'block';
            
            // 난이도 설정
            if (difficulty === 'easy') {
                speed = 4;
                maxTime = 80;
            } else if (difficulty === 'medium') {
                speed = 6;
                maxTime = 50;
            } else if (difficulty === 'hard') {
                speed = 9;
                maxTime = 30;
            }

            // 문제 섞기
            gameWords = [...wordDatabase].sort(() => Math.random() - 0.5);
            currentIndex = 0;
            score = 0;
            timeLeft = maxTime;
            isPaused = false;
            gameActive = true;

            txtTotal.textContent = gameWords.length;
            txtScore.textContent = score;
            txtTimer.textContent = timeLeft;

            initQuestion();
            
            // 타이머 구동
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                if (!isPaused && gameActive) {
                    timeLeft--;
                    txtTimer.textContent = timeLeft;
                    if (timeLeft <= 0) {
                        endGame(false); // 시간 초과 종료
                    }
                }
            }, 1000);

            // 게임 루프 시작
            requestAnimationFrame(update);
        }

        // 문제 출제 및 장애물 리셋
        function initQuestion() {
            if (currentIndex >= gameWords.length) {
                endGame(true); // 성공 탈출
                return;
            }
            txtCurrent.textContent = currentIndex + 1;
            obstacle.textContent = gameWords[currentIndex].word;
            obstacle.style.right = '-150px'; // 우측 바깥에 대기
        }

        // 프레임 업데이트 (장애물 이동)
        function update() {
            if (!gameActive) return;

            if (!isPaused) {
                // 장애물 왼쪽으로 이동
                let currentRight = parseFloat(obstacle.style.right) || -150;
                currentRight += speed;
                obstacle.style.right = currentRight + 'px';

                // 플레이어가 놓치고 지나쳤거나 충돌 구역에 왔을 때의 판정
                // 스크롤로 다가오다가 일정 선(왼쪽 레이아웃)을 넘어가면 강제 오답 처리
                if (currentRight > 700) { 
                    checkAnswer('none'); // 입력 안 해서 틀림
                    return;
                }
            }
            requestAnimationFrame(update);
        }

        // 조작키 이벤트 리스너
        window.addEventListener('keydown', (e) => {
            if (!gameActive || isPaused) return;

            if (e.key === 'ArrowUp' && !isJumping && !isSliding) {
                // ⬆ 점프 = 동형이의어 판정
                jump();
                checkAnswer('homonym');
            } else if (e.key === 'ArrowDown' && !isJumping && !isSliding) {
                // ⬇ 슬라이드 = 다의어 판정
                slide();
                checkAnswer('polysemy');
            }
        });

        function jump() {
            isJumping = true;
            player.style.bottom = '160px';
            player.textContent = '🦘';
            setTimeout(() => {
                player.style.bottom = '50px';
                player.textContent = '🏃';
                isJumping = false;
            }, 400);
        }

        function slide() {
            isSliding = true;
            player.style.height = '30px';
            player.style.bottom = '50px';
            player.textContent = '🦫';
            setTimeout(() => {
                player.style.height = '60px';
                player.textContent = '🏃';
                isSliding = false;
            }, 400);
        }

        // 정답 검사
        function checkAnswer(userChoice) {
            const currentData = gameWords[currentIndex];
            
            if (userChoice === currentData.type) {
                // 정답인 경우
                score++;
                txtScore.textContent = score;
                currentIndex++;
                initQuestion();
            } else {
                // 오답이거나 타이밍 놓친 경우 -> 일시정지 후 해설 출력
                isPaused = true;
                showExplanation(currentData, userChoice === 'none');
            }
        }

        // 해설 상자 띄우기
        function showExplanation(data, isTimeout) {
            expBox.style.display = 'block';
            if(isTimeout) {
                expTitle.textContent = "타이밍을 놓쳤습니다! 😮";
                expTitle.style.color = "#ff9800";
            } else {
                expTitle.textContent = "틀렸습니다! ❌";
                expTitle.style.color = "#f44336";
            }
            expText.innerHTML = `
                <p><b>단어:</b> ${data.word}</p>
                <p><b>기본 뜻:</b> ${data.meaning}</p>
                <hr>
                <p>${data.exp}</p>
            `;
        }

        // 해설창 확인 후 다음 문제 진행
        function nextQuestion() {
            expBox.style.display = 'none';
            isPaused = false;
            currentIndex++;
            initQuestion();
        }

        // 게임 종료 화면
        function endGame(isSuccess) {
            gameActive = false;
            clearInterval(timerInterval);
            gameContainer.style.display = 'none';
            resultScreen.style.display = 'block';

            const accuracy = Math.round((score / gameWords.length) * 100);
            const resultTitle = document.getElementById('result-title');
            
            if (isSuccess && timeLeft > 0) {
                resultTitle.textContent = "🎉 축하합니다! 완주 성공 🎉";
                resultTitle.style.color = "#4CAF50";
            } else {
                resultTitle.textContent = "⏱️ 시간 초과 또는 실패 ⏱️";
                resultTitle.style.color = "#f44336";
            }

            document.getElementById('result-stats').innerHTML = `
                최종 정답률: <b>${accuracy}%</b> (${gameWords.length}문제 중 ${score}문제 완료)<br>
                남은 시간: <b>${timeLeft}초</b> (설정된 최대시간: ${maxTime}초)
            `;
        }

        function returnToLobby() {
            resultScreen.style.display = 'none';
            lobby.style.display = 'block';
        }
    </script>
</body>
</html>
